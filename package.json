{
  "name": "@nzk/dsh-plugin-vrcs",
  "version": "3.0.0-beta.9",
  "private": true,
  "description": "DSH profile bundle that bridges the csgraph stdio MCP server (C# graph + refactor tools) into the harness as mcp__csgraph__* tools.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "install.sh",
    "lib/**/*.mjs",
    "test/**/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "node test/smoke.mjs",
    "test": "node test/smoke.mjs",
    "test:config": "node --test test/config.test.mjs",
    "install:dry-run": "./install.sh --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
